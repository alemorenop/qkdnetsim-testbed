# syntax=docker/dockerfile:1.7
# Pristine upstream QKDNetSim -- NEW baseline (ns-3.48, PQC).
#
# This is NOT the qkdnetsim-testbed fork. It is vanilla QKDNetSim, built as a
# plain ns-3 contrib module and run as a single monolithic process, exactly as
# upstream intends (upstream ships no Docker/emulation infrastructure of its
# own). Its only purpose here is to be the "before" comparison point for
# qkdnetsim-testbed's non-monolithic adaptation (docker/Dockerfile from
# testbed commit d9f0fc4).
#
# Pinned to commit 525e9bf ("QKDNetSim compatible with NS-3 v3.48"), the
# current upstream tip, which adds QKD+PQC key mixing (7a99fc1) and the
# ns-3.48 migration on top of the OLD baseline (1cda34c, see Dockerfile.base-old).
#
# NOTE on PQC: pristine upstream's CMakeLists.txt at this commit defines the
# QKDNETSIM_WITH_PQC option, and its README documents installing liboqs +
# liboqs-cpp then reconfiguring with -DQKDNETSIM_WITH_PQC=ON, but the checked-in
# CMakeLists.txt never calls find_package(liboqs-cpp) or links
# OQS_LIBRARY/liboqs-cpp into the qkdnetsim target -- so following the README
# to the letter still fails to build ("LIBOQS_CPP_VERSION was not declared").
# qkdnetsim-testbed commit d9f0fc4 fixes exactly this gap in its
# CMakeLists.txt. To keep base-new a meaningful comparison point for
# qkdnetsim-testbed:new (PQC enabled), this image inserts ONLY that same
# isolated CMake-wiring fix (see the python3 step below -- the exact block
# also lives, for reference, in qkdnetsim-testbed's own CMakeLists.txt). No
# application/model source code is touched -- the fix is pure CMake plumbing
# that makes upstream's own documented, unmodified PQC example
# (examples_qkdnetsim_secoqc_qkd_and_pqc.cc) buildable as upstream intends.
#
# The fix is applied as a plain text-anchor insertion (not a `patch`/`git
# apply` diff): contrib/qkdnetsim/ is listed in ns-3's own contrib/.gitignore
# (it's meant to be a plugged-in external module), and since this directory
# sits inside the ns-3.48 git clone's working tree, `git apply` silently
# no-ops on gitignored paths (reports success, writes nothing, no error).
# `patch` avoids that but chokes on upstream's CRLF line endings in
# CMakeLists.txt ("different line endings", every hunk fails). Editing the
# file directly in Python sidesteps both traps.
#
# Build context must be the pristine QKDNetSim tree at that commit
# (build-all.sh handles this via `git archive 525e9bf...`) -- NOT this
# directory. Supplying the local archived object avoids depending on a moving
# remote branch:
#   git archive 525e9bf7882ff51b7e197a9fd2ca9ba0b19af0c9 | tar -x -C <tmpdir>
#   docker build -t qkdnetsim:base-new -f Dockerfile.base-new <tmpdir>
#
# Run an example inside the container:
#   docker run --rm -it qkdnetsim:base-new
#   ./ns3 run examples_qkdnetsim_etsi_004
#   ./ns3 run examples_qkdnetsim_etsi_014
#   ./ns3 run examples_qkdnetsim_secoqc
#   ./ns3 run examples_qkdnetsim_secoqc_qkd_and_pqc

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ninja-build \
    gcc g++ python3 python3-dev python3-pip mercurial bzr gdb valgrind gsl-bin doxygen graphviz imagemagick \
    libboost-all-dev git flex bison tcpdump sqlite3 \
    libsqlite3-dev libxml2 libxml2-dev libgtk2.0-0 libgtk2.0-dev uncrustify \
    libcrypto++-dev libcrypto++-doc libcrypto++-utils unzip wget uuid-dev cmake \
    ca-certificates libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# ns-3.48 requires CMake >= 3.25. Ubuntu 22.04 ships 3.22, so install a
# current CMake in /usr/local/bin while retaining the distro package for its
# ancillary files and dependency compatibility.
RUN python3 -m pip install --no-cache-dir "cmake>=3.25,<4"

# --- Reproducible PQC toolchain ---
# liboqs provides ML-KEM-512 and liboqs-cpp is the header-only C++ wrapper
# used by QKDNetSim's KMS. Same pinned versions as qkdnetsim-testbed's own
# docker/Dockerfile, so the PQC ABI is comparable between the two.
ARG LIBOQS_VERSION=0.12.0
ARG LIBOQS_CPP_COMMIT=2d5703f5028e55a777caf68ebab32b8c5475f3a7
RUN git clone --branch ${LIBOQS_VERSION} --depth 1 https://github.com/open-quantum-safe/liboqs.git /opt/liboqs && \
    cmake -S /opt/liboqs -B /opt/liboqs/build -GNinja \
      -DBUILD_SHARED_LIBS=ON -DOQS_BUILD_ONLY_LIB=ON \
      -DOQS_MINIMAL_BUILD="KEM_ml_kem_512" && \
    cmake --build /opt/liboqs/build && \
    cmake --install /opt/liboqs/build && \
    git clone https://github.com/open-quantum-safe/liboqs-cpp.git /opt/liboqs-cpp && \
    git -C /opt/liboqs-cpp checkout ${LIBOQS_CPP_COMMIT} && \
    cmake -S /opt/liboqs-cpp -B /opt/liboqs-cpp/build -GNinja && \
    cmake --build /opt/liboqs-cpp/build --target install && \
    ldconfig && \
    rm -rf /opt/liboqs /opt/liboqs-cpp

WORKDIR /opt

# --- ns-3.48, required by the current official QKDNetSim baseline ---
RUN git clone -b ns-3.48 https://gitlab.com/nsnam/ns-3-dev.git

# --- Pristine upstream QKDNetSim, pinned to the current tip 525e9bf --
# supplied via the build context (see header comment) ---
COPY . /opt/ns-3-dev/contrib/qkdnetsim

WORKDIR /opt/ns-3-dev

# --- Official patches on src/stats/model/gnuplot.{cc,h}, shipped by upstream
# itself in contrib/qkdnetsim/patches/ ---
RUN sed -i 's/\r$//' \
        contrib/qkdnetsim/patches/gnuplot_cc.patches \
        contrib/qkdnetsim/patches/gnuplot_h.patches && \
    git apply --check contrib/qkdnetsim/patches/gnuplot_cc.patches && \
    git apply --check contrib/qkdnetsim/patches/gnuplot_h.patches && \
    git apply contrib/qkdnetsim/patches/gnuplot_h.patches && \
    git apply contrib/qkdnetsim/patches/gnuplot_cc.patches

# --- CMake-wiring fix for PQC (see NOTE on PQC above): inserts the same
# find_package/find_path/find_library/link block already present in
# qkdnetsim-testbed's develop branch, by anchored text replacement. ---
RUN python3 <<'PYEOF'
import pathlib

path = pathlib.Path("contrib/qkdnetsim/CMakeLists.txt")
text = path.read_text()  # universal newlines: CRLF/CR are normalized to '\n' on read

anchor_option = '''option(QKDNETSIM_WITH_PQC
  "Enable post-quantum cryptography support"
  OFF
)
'''
pqc_wiring_block = '''
if(QKDNETSIM_WITH_PQC)
  find_package(liboqs-cpp CONFIG REQUIRED)
  find_path(OQS_INCLUDE_DIR
    NAMES oqs/oqs.h
    PATHS /usr/local/include /usr/include
  )
  find_path(OQS_CPP_INCLUDE_DIR
    NAMES oqs_cpp.hpp
    PATH_SUFFIXES liboqs-cpp
    PATHS /usr/local/include /usr/include
  )
  find_library(OQS_LIBRARY
    NAMES oqs
    PATHS /usr/local/lib /usr/lib /usr/lib/x86_64-linux-gnu
  )

  if(NOT OQS_INCLUDE_DIR OR NOT OQS_CPP_INCLUDE_DIR OR NOT OQS_LIBRARY)
    message(FATAL_ERROR
      "QKDNETSIM_WITH_PQC requires liboqs and liboqs-cpp. "
      "Install both projects or configure with -DQKDNETSIM_WITH_PQC=OFF.")
  endif()

  include_directories(${OQS_INCLUDE_DIR} ${OQS_CPP_INCLUDE_DIR})
  set(OQS_CPP_TARGET liboqs-cpp)
endif()
'''
assert text.count(anchor_option) == 1, "option(QKDNETSIM_WITH_PQC ...) block not found exactly once"
text = text.replace(anchor_option, anchor_option + pqc_wiring_block)

anchor_libs = "    ${uuid_LIBRARIES}\n)"
libs_with_oqs = "    ${uuid_LIBRARIES}\n    ${OQS_LIBRARY}\n    ${OQS_CPP_TARGET}\n)"
assert text.count(anchor_libs) == 1, "LIBRARIES_TO_LINK closing block not found exactly once"
text = text.replace(anchor_libs, libs_with_oqs)

path.write_text(text)
print("PQC CMake wiring inserted OK")
PYEOF

# --- Configure and build the monolithic examples relevant to the comparison,
# including upstream's own PQC example (skip --enable-mpi:
# examples_qkdnetsim_etsi_combined_input is the only target that needs it,
# and it's out of scope here) ---
RUN ./ns3 configure --enable-examples -- -DQKDNETSIM_WITH_PQC=ON && \
    ./ns3 build \
        examples_qkdnetsim_etsi_004 \
        examples_qkdnetsim_etsi_014 \
        examples_qkdnetsim_secoqc \
        examples_qkdnetsim_secoqc_qkd_and_pqc

CMD ["/bin/bash"]
